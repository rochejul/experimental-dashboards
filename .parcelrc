{
  "extends": "@parcel/config-default",
  "transformers": {
    "*.css": [
      "@parcel/transformer-postcss"
    ],
    "*.{js,mjs,jsm,jsx,es6,cjs,ts,tsx}": [
      "@parcel/transformer-babel",
      "@parcel/transformer-js"
    ]
  },
  "packagers": {
    "*.css": "@parcel/packager-raw"
  },
  "optimizers": {
    "*.{css}": [],
    "*.{js,mjs,cjs}": []
  }
}
